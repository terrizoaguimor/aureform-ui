# Empty for localhost and sites served at the domain root.
# Set to /aureform-ui when building the GitHub Pages demo.
NEXT_PUBLIC_BASE_PATH=

# The frontend demo requires no API keys or backend services.
# Store private service credentials outside this repository.

# Optional browser key for the Maps JavaScript API. Restrict its referrers/API.
# It is public in the Next.js build; never put a server/Stripe secret here.
# The default map remains local until the visitor selects Google Maps.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
