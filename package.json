{
  "name": "aureform-ui",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "An open source Next.js UI kit with SaaS workflows, six palettes, an appearance studio and an editable Figma design system.",
  "license": "Apache-2.0",
  "author": "terrizoaguimor",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrizoaguimor/aureform-ui.git"
  },
  "homepage": "https://terrizoaguimor.github.io/aureform-ui/",
  "bugs": {
    "url": "https://github.com/terrizoaguimor/aureform-ui/issues"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "pnpm tokens && pnpm registry && next build",
    "start": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tokens": "node --experimental-strip-types scripts/generate-tokens.mjs",
    "registry": "node scripts/generate-registry.mjs",
    "coverage": "node scripts/generate-coverage.mjs",
    "verify:examples": "node scripts/verify-component-examples.cjs",
    "verify:code-connect": "node scripts/verify-code-connect.cjs",
    "verify:copy": "node --experimental-strip-types scripts/verify-copy-examples.mjs",
    "verify:motion": "node scripts/verify-motion.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "package:source": "node scripts/package-source.mjs",
    "verify:public": "python3 scripts/audit-public.py",
    "verify:pages": "node scripts/verify-pages-export.mjs",
    "verify:demo": "node --experimental-strip-types scripts/verify-public-demo.mjs",
    "capture:readme": "node --experimental-strip-types scripts/capture-readme.mjs",
    "format": "prettier --write src scripts bin tests *.mjs *.json",
    "verify:appearance": "node --experimental-strip-types scripts/verify-appearance.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "lenis": "^1.3.27",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^5.13.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "shadcn": "4.22.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
